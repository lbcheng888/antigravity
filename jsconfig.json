{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "."
  },
  "include": [
    "dist/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
